# Nginx reverse proxy for gitlab-webhook-relay
#
# Sits between GitLab and the relay.
# Validates X-Gitlab-Token here so the relay never receives bad requests.
# Recommended: bind to your internal network interface only.

server {
    # Replace with your internal IP / interface
    listen 10.0.0.1:9090;
    server_name _;

    location /webhook {
        # Reject requests with wrong GitLab secret immediately at nginx level
        if ($http_x_gitlab_token != "YOUR_GITLAB_WEBHOOK_SECRET") {
            return 403;
        }

        proxy_pass          http://127.0.0.1:9091;
        proxy_set_header    Host            localhost;
        proxy_set_header    X-Forwarded-For $remote_addr;
        proxy_read_timeout  60s;
        proxy_connect_timeout 10s;
    }

    location /health {
        proxy_pass http://127.0.0.1:9091;
    }

    location / {
        return 404;
    }
}
