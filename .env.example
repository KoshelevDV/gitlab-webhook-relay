# ─── Server ──────────────────────────────────────────────────────────────────
# Address and port the relay listens on
# Use 127.0.0.1 when sitting behind nginx/caddy (recommended)
# Use 0.0.0.0 only if you expose it directly
HOST=127.0.0.1
PORT=9091

# ─── GitLab ──────────────────────────────────────────────────────────────────
# Secret token configured in GitLab webhook settings
# GitLab → Project → Settings → Webhooks → Secret token
GITLAB_WEBHOOK_SECRET=change-me-strong-random-secret

# GitLab personal access token (api scope) for the agent's GitLab account
# Used to: fetch MR diffs, check approvals, post approve/unapprove
GITLAB_TOKEN=glpat-change-me

# GitLab API base URL (recommended: set explicitly to avoid HTTP→HTTPS redirect issues)
# Defaults to deriving from the MR URL in the webhook payload
GITLAB_API_URL=https://gitlab.example.com/api/v4

# ─── OpenClaw ────────────────────────────────────────────────────────────────
# Full URL to your OpenClaw /hooks/agent endpoint
OPENCLAW_HOOKS_URL=http://127.0.0.1:18789/hooks/agent

# OpenClaw webhook token (configured in openclaw.json hooks.token)
OPENCLAW_HOOKS_TOKEN=change-me-openclaw-token

# ─── Delivery (optional) ─────────────────────────────────────────────────────
# Telegram chat ID to receive code review results
# Leave empty to use OpenClaw's default delivery
TELEGRAM_CHAT_ID=

# Agent timeout in seconds (default: 300)
TIMEOUT_SECONDS=300

# ─── Semantic memory ──────────────────────────────────────────────────────────
# Path to mcporter binary for semantic context recall before code review
# Leave empty to disable semantic memory enrichment
MCPORTER_BIN=/home/user/.npm-global/bin/mcporter
